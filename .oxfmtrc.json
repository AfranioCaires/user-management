{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./apps/frontend/src/styles/index.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    ".claude",
    "skills-lock.json",
    "pnpm-lock.yaml",
    "**/dist",
    "**/coverage",
    "**/storybook-static",
    "**/*.pdf"
  ]
}
